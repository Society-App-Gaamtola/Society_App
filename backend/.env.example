# Copy to .env for local work, or add each line as an environment variable on the host (Render).
# Never commit the real .env.

# production turns on real OTPs (emailed). Anything else uses the test OTP 123456.
NODE_ENV=production

# The host sets PORT itself (Render does); locally it defaults to 5020.
# PORT=5020

# Public address of this API, used to build image links, e.g. https://society-app.onrender.com
BASE_URL=
ADMIN_PANEL_URL=http://localhost:3000

# Long random strings. API_KEY must match EXPO_PUBLIC_API_KEY in frontend/mobile/.env
JWT_WEB_TOKEN=
API_KEY=
# AES for encrypted request bodies: KEY exactly 32 characters, IV exactly 16
KEY=
IV=

# MySQL. Local XAMPP: localhost / 3306 / root / empty password, no DB_SSL_CA.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=society_app
# Hosted MySQL (Aiven): paste the CA certificate from the service page (keep the BEGIN/END lines)
DB_SSL_CA=

# Email for OTPs. On hosts that block email ports (Render free plan) set BREVO_API_KEY: mail then goes
# through Brevo over HTTPS, sent from MAIL_FROM (a sender verified in Brevo). Without it, Gmail SMTP is used
# (Gmail: use an App Password, not the account password)
BREVO_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
APP_NAME=Gaamtoda Mitra Mandal
