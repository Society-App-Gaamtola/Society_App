{
  "expo": {
    "name": "Shri Gamtola Yuvak Mitra Mandal",
    "slug": "kartikmaji_gaamtoda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gaamtoda.society",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8EE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "imageWidth": 160,
          "backgroundColor": "#FFF8EE",
          "image": "./assets/logo.png"
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-asset",
      "expo-secure-store",
      "expo-video",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }"
          }
        }
      ]
    ],
    "backgroundColor": "#FFF8EE",
    "extra": {
      "eas": {
        "projectId": "f9060c10-0b08-4fb1-be54-43cea532408f"
      }
    },
    "owner": "milanpatel1212"
  }
}
