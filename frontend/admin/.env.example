# The real backend (backend/). The api-key is the backend's API_KEY (it's shipped to the browser, like the mobile app's)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5020/api/v1
NEXT_PUBLIC_BACKEND_API_KEY=
# Cloudinary (the same unsigned preset as the mobile app). ENV_FOLDER must match the backend: production on the live
# server, development locally (the backend only accepts links in society_app/<that folder>/events/<yyyy>/<mm>/)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_ENV_FOLDER=development
